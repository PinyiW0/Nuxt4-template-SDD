#!/usr/bin/env sh
# Pre-push：只跑煙霧 spec（由下方 SMOKE_PATTERN 定義；模板預設 00-hydration｜01-auth-guard｜02-authz-scope：逐 route 整頁載入／auth 守衛／authz scope），本機 dev server。
#
# 分級（SSOT：.claude/skills/vibe-check/SKILL.md）：
#   本機 /vibe-check 預設定向（煙霧＋受影響 spec）、/ship L2 跑 dev 全量、
#   CI 的 e2e job（.github/workflows/pull_request.yml）跑 production build 全量——
#   「改 A 有沒有壞 B」的完整回歸在 CI，不在這裡。pre-push 防的是手滑：整頁載不出來、
#   auth／authz 守衛失效這種一推就炸的東西，一兩分鐘內給答案。
# scripts/docker-gate.sh（production 全量）改為 /ship --prod-gate 的本機選配，pre-push 不再呼叫它。
# specs/ 紅燈 = 破壞 Business Invariant（修 UI 不可改 spec）。
#
# 最佳化：若本次 push 的 commit「只動到非程式碼檔」（.env*／docs／docker 設定等），
# 這些變更不會影響被測程式邏輯，因此跳過測試，不必空等。
# 保守原則：只要有任何一個程式碼檔被改到，就照常跑煙霧。
# 注意：SKIP_PATTERN／FORCE_TEST_PATTERN 這兩行也被 .claude/skills/ship/scripts/ledger.sh 用 sed 抽走當 L2 判準，
# 格式（單引號、一行）不可變。

z40="0000000000000000000000000000000000000000"

# 非程式碼檔白名單（符合者視為不影響測試）：
#   .env*／*.md／docker 設定／*.txt 等純設定，以及 .husky/ 下的 git hook 本身
#   （E2E 守的是 UI 業務合約，git hook 邏輯不歸它守，故改 hook 不必跑 E2E）
#   doc/ 整個目錄為純文件（含 .json metadata sidecar 等），不影響被測程式
#   scripts/docker-gate.sh 是 gate 基礎設施本身，同 .husky/ 邏輯
#   i18n/locales/ 整目錄放行：E2E spec 全數跑在 defaultLocale（zh-TW）、斷言繁中業務文字，
#   非預設語系檔（ja.json、en.json…）不影響測試結果；整目錄放行讓新增語系不必回來加 pattern。
#   唯 defaultLocale 檔是斷言文案來源、視為程式碼，由下方 FORCE_TEST_PATTERN 拉回強制跑。
#   模板尚無 i18n 目錄，pattern 先就位；導入 @nuxtjs/i18n（預設 restructureDir=i18n）後自動生效。
#   ⚠️ 未來若新增「語言切換」E2E 測試情境，非預設語系檔也會影響測試 → 這條放行必須整個拿掉。
SKIP_PATTERN='(^|/)\.env($|\.)|\.md$|^docker-compose\.ya?ml$|^Dockerfile$|^\.dockerignore$|^\.gitignore$|^LICENSE$|\.txt$|(^|/)\.husky/|(^|/)doc/|^scripts/docker-gate\.sh$|^i18n/locales/'

# 強制跑清單（優先於 SKIP_PATTERN）：落在放行目錄內、但實質是「程式碼」的檔。
# i18n defaultLocale（zh-TW）翻譯檔是 E2E 文字斷言的文案來源，改它可能改掉斷言目標。
# 若 nuxt.config 的 defaultLocale 換了，這裡要同步改成新 defaultLocale 的檔名。
FORCE_TEST_PATTERN='^i18n/locales/zh-TW\.json$'

# 煙霧集合（#150 分級的最小集合）：regex，對 spec 檔路徑比對（Playwright 位置參數語意）。
# 模板預設是 /test e2e setup 產出的三支固定檔名；setup 之前建立的舊專案依實際檔名改這一行
# （例：'specs/(00-hydration|00-auth)'）。/vibe-check 用 sed 抽這一行當同一份判準，格式（單引號、一行）不可變。
SMOKE_PATTERN='specs/(00-hydration|01-auth-guard|02-authz-scope)'

# ── 設定自檢（一定放在下方「要不要跑」判定之前）──
# .husky/ 本身在 SKIP_PATTERN 內：只改這個檔的 push 會走「跳過測試」那條路。自檢若放在那之後，
# 把 pattern 改壞的那次 push 會直接推上去（CI 不跑 hook），之後每次 push 都靜默放行或跑錯集合。
# 判準是 grep 的 exit code 2（非法 ERE）；合法 pattern 對空輸入回 1 是正常的（同 ledger.sh 的 ere_ok）。
ere_ok() { rc=0; printf '' | grep -qE "$1" 2>/dev/null || rc=$?; [ "$rc" -le 1 ]; }
# 空字串會反轉語意：grep -vE '' 把所有檔濾掉（永遠跳過測試）、grep -E '' 命中所有 spec（煙霧變整份 gate），
# 而 /vibe-check 抽到空的 SMOKE_PATTERN 會改用模板預設，兩邊判準就不一致——一律擋下。FORCE_TEST_PATTERN 允許留空。
for name in SKIP_PATTERN SMOKE_PATTERN; do
  eval "val=\$$name"
  if [ -z "$val" ]; then
    echo "❌ ${name} 是空的 → 拒絕 push。請在 .husky/pre-push 填回實際的 regex（SMOKE_PATTERN 模板預設 'specs/(00-hydration|01-auth-guard|02-authz-scope)'）。"
    exit 1
  fi
done
for name in SKIP_PATTERN FORCE_TEST_PATTERN SMOKE_PATTERN; do
  eval "val=\$$name"
  if ! ere_ok "$val"; then
    echo "❌ ${name} 不是合法的 ERE（${val}）→ 拒絕 push。"
    echo "   請修正 .husky/pre-push 的 ${name} 那一行（/vibe-check 用 sed 抽同一份判準；ledger.sh 讀 SKIP／FORCE 兩行）。"
    exit 1
  fi
done

need_test=0

# git 透過 stdin 傳入 <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  # 刪除遠端分支（local_sha 全 0）：無內容可測，略過
  [ "$local_sha" = "$z40" ] && continue

  if [ "$remote_sha" = "$z40" ]; then
    # 新分支：無法可靠界定變更範圍，保守起見照跑煙霧
    need_test=1
    break
  fi

  files=$(git diff --name-only "$remote_sha" "$local_sha")
  # 命中強制跑清單（defaultLocale 翻譯檔）→ 不看白名單，直接跑測試（留空＝沒有強制清單，不是「全部強制」）
  if [ -n "$FORCE_TEST_PATTERN" ] && printf '%s\n' "$files" | grep -qE "$FORCE_TEST_PATTERN"; then
    need_test=1
    break
  fi
  # 濾掉白名單後若仍有剩 → 有程式碼變更，需要跑測試
  # 注意：husky 以 `sh -e` 執行本檔，grep 全濾掉時回傳 1 會觸發 errexit，故加 || true
  remaining=$(printf '%s\n' "$files" | grep -vE "$SKIP_PATTERN" || true)
  if [ -n "$remaining" ]; then
    need_test=1
    break
  fi
done

if [ "$need_test" -eq 0 ]; then
  echo "✅ 本次 push 只動到非程式碼檔（.env／docs／docker／非預設語系翻譯檔等），不影響測試 → 跳過煙霧 spec。"
  exit 0
fi

# 煙霧 spec 由 /test e2e setup 產出（模板預設檔名見 SMOKE_PATTERN）。沒有任何檔命中 SMOKE_PATTERN
# （setup 之前、或舊專案還沒改 SMOKE_PATTERN）→ 印警告放行；production 全量仍由 CI 守。
# 比對對象要跟 Playwright 一樣：它把位置參數當 regex、對 spec 的「絕對路徑」比對、不分大小寫（實測：'^specs/x' 找不到、
# '^/.*specs/x' 找得到、大寫也找得到）。所以這裡 find 用絕對路徑、grep 加 -i，同一個 pattern 在兩邊命中的檔才一致；
# 用 ^ 錨定 specs/ 的 pattern 在兩邊都不會命中，別這樣寫。兩邊的 regex 方言不同（JS vs POSIX ERE），只用交集：
# 分組、| 交替、字元集；\d、(?:…) 這類 JS 專屬寫法不要用。
# 注意：目錄不存在時 find 回非 0、grep 沒命中回 1，sh -e 會觸發 errexit，故加 || true
smoke_specs=$(find "$PWD/test/e2e/specs" -name '*.spec.ts' 2>/dev/null | grep -iE "$SMOKE_PATTERN" || true)
if [ -z "$smoke_specs" ]; then
  echo "⚠️  沒有 spec 檔命中 SMOKE_PATTERN（${SMOKE_PATTERN}）→ 跳過 pre-push 煙霧。"
  echo "   （跑過 /test e2e setup 後才會有；舊專案請把 SMOKE_PATTERN 改成實際的煙霧檔名。production 全量仍由 CI 的 e2e job 守。）"
  exit 0
fi

# 位置參數是對檔案路徑做 regex 比對，SMOKE_PATTERN 一個 pattern 涵蓋所有煙霧檔；用完整檔名不用 00–02 前綴——
# feature spec 的編號可以從 01 起（如 01-使用者登入.spec.ts），前綴會把它們一起收進來。
# --reporter=line 只印失敗——AI 執行 git push 時回到對話的輸出只剩有用的部分（config 預設 list 每條測試印一行）。
# 刻意不用 --last-failed：它與檔名篩選是 AND、缺 .last-run.json 時靜默跑全量、零失敗時 exit 1。
# 注意：husky 以 sh -e 執行本檔，用 `|| gate_status=$?` 接住失敗才能印出下方分流指引
echo "🔍 Running smoke spec（${SMOKE_PATTERN}，dev server）…"
gate_status=0
npx playwright test --config playwright.gate.config.ts --reporter=line "$SMOKE_PATTERN" || gate_status=$?

if [ "$gate_status" -ne 0 ]; then
  echo ""
  echo "❌ Smoke spec failed. 依失敗的 spec 分流："
  echo "   → 00-hydration 紅燈 = 某條 route 整頁載不出來或有 hydration 警告；先本機開該頁看 console。"
  echo "      （煙霧集合由本檔 SMOKE_PATTERN 定義；下面兩條以模板預設檔名為例）"
  echo "   → 01-auth-guard／02-authz-scope 紅燈 = 登入守衛或巢狀 scope 授權壞了；"
  echo "     對照 spec/report/route-map.yaml 的 auth／rbac 區塊修 middleware／server，不可改 test/e2e/specs/（凍結）。"
  echo "   → 緊急情況可用 --no-verify 跳過（不推薦；那會讓 CI 成為唯一守門）。"
  exit 1
fi

echo "✅ Smoke spec passed. Push proceeding（production 全量由 CI 的 e2e job 跑）。"
